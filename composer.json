{
  "name": "ondewo/s2t-client-php",
  "description": "ONDEWO S2T (Speech-to-Text) gRPC client for PHP, generated from the ondewo-s2t-api protocol buffer definitions",
  "type": "library",
  "keywords": [
    "ondewo",
    "s2t",
    "grpc",
    "protobuf",
    "client"
  ],
  "homepage": "https://github.com/ondewo/ondewo-s2t-client-php",
  "license": "Apache-2.0",
  "authors": [
    {
      "name": "ONDEWO GmbH",
      "email": "office@ondewo.com",
      "homepage": "https://www.ondewo.com"
    }
  ],
  "support": {
    "issues": "https://github.com/ondewo/ondewo-s2t-client-php/issues",
    "source": "https://github.com/ondewo/ondewo-s2t-client-php"
  },
  "require": {
    "ext-grpc": "*",
    "google/protobuf": "4.33.6",
    "grpc/grpc": "1.82.0",
    "php": ">=8.1.0"
  },
  "suggest": {
    "psr/log": "To receive ClientConfig's insecure-channel warning on a PSR-3 logger instead of error_log()"
  },
  "autoload": {
    "classmap": [
      "auth/",
      "src/"
    ],
    "psr-4": {
      "Ondewo\\S2t\\Auth\\": "auth/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Ondewo\\S2t\\Tests\\": "tests/"
    }
  },
  "version": "7.5.1"
}
